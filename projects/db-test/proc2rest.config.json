{
    "jsClients": ["src/client/index.js"],
    "servers": [
        {
            "src": "src/server/server.ts",
            "namespace": "Server"
        }
    ],
    "apiUrl": "http://localhost:3000",
    "cors": {
        "origin": "*"
    },
    "method-rules": {
        "GET": "^(get|list|find)",
        "POST": "^(create|add|insert)",
        "PATCH": "^(update|set|patch)",
        "DELETE": "^(delete|remove)"
    },
    "binaryTypes": [
        "ArrayBuffer",
        "Uint8Array",
        "Uint8Array<ArrayBufferLike>",
        "Buffer",
        "Blob",
        "ImageData",
        "File"
    ]
}
